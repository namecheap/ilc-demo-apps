{
  "private": true,
  "name": "headline-news",
  "version": "1.0.0",
  "description": "Displays news articles",
  "main": "server.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "cross-env NODE_ENV=development concurrently --kill-others --kill-others-on-fail --names \"server,client\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon --watch server.js --watch dist ./server.js",
    "dev:client": "nodemon -e js,mjs,json,vue --watch src --exec npm run build",
    "start": "cross-env NODE_ENV=production node server",
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && cross-env NODE_ENV=production webpack"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "express": "^4.21.2",
    "ilc-adapter-vue": "^1.9.2",
    "ilc-sdk": "^7.0.0",
    "lru-cache": "^4.1.5",
    "vue": "^2.7.16",
    "vue-meta": "^2.4.0",
    "vue-router": "^3.6.5",
    "vue-server-renderer": "^2.7.16",
    "vuex": "^3.6.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.28.0",
    "babel-loader": "^10.0.0",
    "concurrently": "^9.2.1",
    "css-loader": "^7.1.2",
    "mini-css-extract-plugin": "^2.9.2",
    "nodemon": "^3.1.10",
    "vue-loader": "^15.11.1",
    "vue-style-loader": "^4.1.3",
    "webpack": "^5.101.0",
    "webpack-cli": "^6.0.1",
    "webpack-node-externals": "^3.0.0"
  },
  "overrides": {
    "@vue/component-compiler-utils": {
      "postcss": "^8.5.23",
      "postcss-selector-parser": "^7.1.6"
    },
    "vue-server-renderer": {
      "serialize-javascript": "^7.0.5"
    },
    "concurrently": {
      "shell-quote": "^1.11.0"
    }
  }
}
